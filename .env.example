# === Django ===
SECRET_KEY=your-secret-key-here-CHANGE-ME
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,

# === База данных ===
DATABASE_URL=sqlite:///db.sqlite3

# === Email ===
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# === Дополнительные настройки ===
TIMEZONE=UTC
LANGUAGE_CODE=en

# === Прокси ===
# Включайте USE_X_FORWARDED_FOR только если приложение стоит за прокси,
# и обязательно перечислите адреса этого прокси в TRUSTED_PROXIES.
# Без списка заголовок игнорируется: его левое значение подделывается клиентом.
USE_X_FORWARDED_FOR=False
TRUSTED_PROXIES=
# === Django ===
SECRET_KEY=your-secret-key-here-CHANGE-ME
# Для локальной разработки поставьте True. False по умолчанию — чтобы
# скопированный пример не оказался боевой конфигурацией с DEBUG (П-24).
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,

# === База данных ===
DATABASE_URL=sqlite:///db.sqlite3

# === Email ===
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# === Дополнительные настройки ===
TIMEZONE=UTC
LANGUAGE_CODE=en

# === Прокси ===
# Включайте USE_X_FORWARDED_FOR только если приложение стоит за прокси,
# и обязательно перечислите адреса этого прокси в TRUSTED_PROXIES.
# Без списка заголовок игнорируется: его левое значение подделывается клиентом.
USE_X_FORWARDED_FOR=False
TRUSTED_PROXIES=
# Доверять X-Forwarded-Proto. Выключайте, если прокси его не проставляет:
# иначе Django не видит HTTPS и SECURE_SSL_REDIRECT зацикливается (П-27).
USE_X_FORWARDED_PROTO=True

# === Безопасность (прод) ===
# Значения по умолчанию включаются при DEBUG=False. Задайте явно, если
# прод-окружение может унаследовать dev-.env (П-26).
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False